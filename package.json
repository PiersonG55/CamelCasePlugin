{
	"name": "camel-case-spellcheck",
	"version": "0.1.0",
	"description": "Spellchecks the individual words in camelCase and PascalCase identifiers in Obsidian.",
	"main": "main.js",
	"type": "module",
	"private": true,
	"author": "Pierson Garcia",
	"license": "MIT",
	"engines": {
		"node": ">=22.13.0"
	},
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "node --experimental-strip-types --test test/identifier.test.ts test/spellchecker.test.ts",
		"check": "npm run lint && npm run test && npm run build",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"camel-case",
		"pascal-case",
		"spellcheck"
	],
	"devDependencies": {
		"@codemirror/language": "^6.11.3",
		"@codemirror/state": "^6.5.0",
		"@codemirror/view": "^6.38.6",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"@types/nspell": "^2.1.6",
		"esbuild": "0.25.5",
		"eslint": "^10.8.1",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"obsidian": "latest",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1"
	},
	"dependencies": {
		"dictionary-en": "^4.0.0",
		"nspell": "^2.1.5"
	}
}
